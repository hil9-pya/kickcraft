DB_HOST=localhost
DB_PORT=3306
DB_NAME=kickcraft_db
DB_USER=root
DB_PASS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Owner bootstrap (used once by database/create-owner.php; never commit api/.env)
KICKCRAFT_OWNER_NAME=KickCraft Owner
KICKCRAFT_OWNER_EMAIL=owner@example.com
KICKCRAFT_OWNER_PASSWORD=change-this-password

# Isolated development / Tripo processing
SESSION_NAME=PHPSESSID
SCAN_STORAGE=
BLENDER_EXE=
# Vite terminal: $env:KICKCRAFT_API_TARGET='http://localhost/kickcraft-photo-scan'

# Optional local photo background removal for Tripo inputs.
REALITYSCAN_EXE=

# Tripo V3 cloud generation; store key file outside project/web root.
TRIPO_ENV_FILE=
# Alternative server environment variable: TRIPO_API_KEY (never a VITE_* variable).
